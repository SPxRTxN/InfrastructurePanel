# Скопируйте в .env и заполните. .env не коммитится (он в .gitignore). Права: chmod 600 .env
# Это единственный файл с настройками вашей установки: пути, адреса, ключи. Порядок — README → «Настройка перед первым запуском».

# --- Пути (абсолютные, на хосте) ---
# Каталог проекта (куда склонирован репозиторий) — панель подставляет его в подсказки с командами (push-agent)
# PROJECT_DIR=/opt/homelab-dashboard
# Docker: каталог с БД на хосте (монтируется в /data). По умолчанию ./data рядом с compose.yaml
# DATA_DIR=/srv/homelab/data
# Репозиторий GitHub, откуда панель берёт список релизов (владелец/имя); у форка — свой
# GITHUB_REPO=owner/homelab-dashboard

# Ключ Fernet для шифрования хранимых секретов (обязателен, без него сервер не стартует).
# Сгенерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Храните копию отдельно от бэкапов БД: без ключа пути к SSH-ключам не расшифровать.
SECRET_KEY=

# Пароль администратора admin при самом первом запуске (пустая БД). Пусто — пароль admin.
# На сервере, доступном из интернета, обязательно задайте длинный пароль: admin/admin боты угадают первыми.
# FIRST_ADMIN_PASSWORD=
# Любой секрет можно читать из файла: SECRET_KEY_FILE=/run/secrets/secret_key (см. compose.secrets.yaml)

# --- Шифрование (README → «Шифрование данных»). Ключи лучше держать файлами вне data/, а не здесь ---
# Вся БД — SQLCipher, 64 hex: python3 -c "import secrets; print(secrets.token_hex(32))"
# Существующую открытую БД сначала: python -m app.cli encrypt-db. Потеря ключа = потеря данных.
# DB_ENCRYPTION_KEY=
# «Перец» паролей. Потеря = никто не войдёт (восстановление: app.cli create-admin)
# PASSWORD_PEPPER=
# Публичный ключ age (age-keygen на своём ПК, не на сервере) — бэкапы шифруются в .db.age
# BACKUP_AGE_RECIPIENT=age1...
# Каталог бэкапов — лучше на другом диске, чем БД (в Docker монтируется в /data/backups)
# BACKUP_DIR=/mnt/backup-disk/homelab-backups
# Секреты файлами разом: python tools/setup_secrets.py /mnt/другой-диск/homelab-secrets

# true — cookie сессии только по HTTPS (включить за HTTPS-прокси); заодно включает HSTS
COOKIE_SECURE=false

# Время жизни сессии в часах
SESSION_HOURS=12

# false — отключить фоновые задачи (проверки серверов, напоминания)
SCHEDULER_ENABLED=true

# Часовой пояс для календаря и напоминаний. По умолчанию — пояс системы (в Docker — /etc/localtime хоста).
# TZ=Europe/Moscow

# --- Запуск без Docker (python -m app.cli serve) ---
# Путь к БД. По умолчанию <каталог проекта>/data/homelab.db; указывайте только абсолютный путь.
# DATABASE_URL=sqlite:////srv/homelab/homelab.db
# 127.0.0.1 — только этот ПК; 0.0.0.0 — доступ с других устройств локальной сети
HOST=127.0.0.1
PORT=8000

# --- Docker (compose.yaml; DATABASE_URL/HOST/PORT внутри контейнера задаются compose) ---
# Адрес публикации порта на хосте: 127.0.0.1 — только хост (за прокси), 0.0.0.0 — локальная сеть
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8000
# Образ и тег (tools/deploy.sh задаёт тег сам)
# DASHBOARD_IMAGE=ghcr.io/spxrtxn/infrastructurepanel
