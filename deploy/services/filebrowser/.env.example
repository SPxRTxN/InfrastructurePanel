# Скопировать в .env рядом с compose.yaml и заполнить. Секретов здесь нет.

# Каталог на сервере, который показывает File Browser (создать заранее, владелец — FB_UID:FB_GID).
# Не путь к дискам с важными данными — их сюда не подключаем.
FB_FILES=/mnt/homelab-data/filebrowser/files

# Порт для работы без панели: http://<сервер>:FB_PORT
FB_PORT=8081
# 0.0.0.0 — вся локальная сеть; 127.0.0.1 — только с самого сервера (например, если впереди HTTPS-прокси)
FB_BIND=0.0.0.0

# Пользователь, от которого работает контейнер (владелец FB_FILES и data/)
FB_UID=1000
FB_GID=1000
