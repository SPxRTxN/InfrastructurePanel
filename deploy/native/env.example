# /etc/homelab-dashboard/env — окружение службы homelab-dashboard (права 0600, владелец root).
# Читает systemd (EnvironmentFile) до сброса прав. Формат: KEY=value, без кавычек и пробелов вокруг «=».
# Секретов здесь нет: только пути к файлам в /etc/homelab-dashboard/secrets (0700, владелец homelab-dashboard).
# install.sh создаёт этот файл один раз и больше не перезаписывает.

# --- База данных и бэкапы ---
DATABASE_URL=sqlite:////var/lib/homelab-dashboard/homelab.db
# Каталог бэкапов. Пусто — /var/lib/homelab-dashboard/backups. Другой диск лучше; его нужно
# разрешить службе на запись: systemctl edit homelab-dashboard → [Service] ReadWritePaths=/mnt/backup
# BACKUP_DIR=/mnt/backup/homelab-dashboard
# Публичный ключ age (age-keygen на своём ПК): бэкапы шифруются в .db.age
# BACKUP_AGE_RECIPIENT=age1...

# --- Секреты: файлы создаёт install.sh (tools/setup_secrets.py), на экран не выводятся ---
SECRET_KEY_FILE=/etc/homelab-dashboard/secrets/secret_key
DB_ENCRYPTION_KEY_FILE=/etc/homelab-dashboard/secrets/db_encryption_key
PASSWORD_PEPPER_FILE=/etc/homelab-dashboard/secrets/password_pepper
# Пароль admin при первом запуске (пустая БД); вход требует сменить логин и пароль.
# Прочитать один раз: sudo cat /etc/homelab-dashboard/secrets/first_admin_password
FIRST_ADMIN_PASSWORD_FILE=/etc/homelab-dashboard/secrets/first_admin_password

# --- Сеть ---
# 127.0.0.1 — только этот узел (за reverse proxy, рекомендуется); 0.0.0.0 — вся локальная сеть (без HTTPS)
HOST=127.0.0.1
PORT=8000
# true — cookie только по HTTPS (включить за HTTPS-прокси); заодно включает HSTS
COOKIE_SECURE=false

# --- Прочее ---
SESSION_HOURS=12
# false — без фоновых задач (проверки серверов, напоминания)
SCHEDULER_ENABLED=true
# Часовой пояс календаря; по умолчанию — пояс системы (timedatectl)
# TZ=Europe/Moscow
